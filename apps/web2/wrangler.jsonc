{
  // Walk We web app: the Vite build served as static assets on Workers.
  // Build from the project root before deploying this workspace.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "walkwe-web2",
  "compatibility_date": "2026-10-12",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
