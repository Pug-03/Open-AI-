{
  "name": "walk-we-2",
  "version": "0.1.0",
  "private": true,
  "description": "Walk We — shadier daytime and safer night-time walking routes in Bangkok (mobile-first PWA)",
  "workspaces": [
    "config",
    "packages/*",
    "apps/web2",
    "apps/ai-proxy"
  ],
  "scripts": {
    "dev": "npm --workspace @walkwe/web2 run dev --",
    "build": "npm --workspace @walkwe/web2 run build --",
    "preview": "npm --workspace @walkwe/web2 run preview --",
    "typecheck": "tsc -p config && tsc -p packages/core && tsc -p packages/data && tsc -p apps/web2 && tsc -p apps/ai-proxy",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npm --workspace @walkwe/web2 run test:e2e --",
    "photos": "tsx scripts/build-photos.ts",
    "lighthouse": "tsx scripts/lighthouse.ts",
    "ai:dev": "npm --workspace @walkwe/ai-proxy run dev",
    "ai:deploy": "npm --workspace @walkwe/ai-proxy run deploy"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@types/d3-delaunay": "^6.0.4",
    "@types/node": "^22.10.0",
    "d3-delaunay": "^6.0.4",
    "lighthouse": "^13.5.0",
    "sharp": "^0.35.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.0",
    "vitest": "^5.0.4"
  },
  "type": "module"
}
